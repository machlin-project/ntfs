project('machlin-ntfs', 'c', version: '0.1.0', default_options: ['c_std=c11', 'warning_level=3', 'werror=true', 'buildtype=debugoptimized'])
cc = meson.get_compiler('c')
inc = include_directories('include', 'adapters/posix')
core_sources = files('core/support.c', 'core/operation.c', 'core/api.c', 'core/record.c', 'core/mst.c', 'core/logfile.c', 'core/logfile_source.c', 'core/stream.c', 'core/unit_cache.c', 'core/lznt1.c', 'core/lzx.c', 'core/wof.c', 'core/wof_stream.c', 'core/xpress.c', 'core/attribute.c', 'core/catalog.c', 'core/node.c', 'core/links.c', 'core/unicode.c', 'core/mount.c', 'core/directory.c', 'core/index.c', 'core/reparse.c', 'core/security.c', 'core/secure.c', 'core/access.c', 'core/validate.c')
core_sources += files('core/logfile_tables.c', 'core/checkpoint.c', 'core/logfile_encode.c')
core_flags = ['-ffreestanding', '-fno-builtin', '-Wdeclaration-after-statement', '-Wframe-larger-than=2048']
core = static_library('ntfs', core_sources, include_directories: inc, c_args: core_flags, install: false)
posix = static_library('ntfs-posix', 'adapters/posix/image.c', include_directories: inc, c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
tool_path = files('tools/path.c')
inspector = executable('ntfs-inspect', ['tools/inspect.c', tool_path], include_directories: inc, link_with: [posix, core], install: false)
validator = executable('ntfs-validate', 'tools/validate.c', include_directories: inc, link_with: [posix, core], c_args: ['-Wdeclaration-after-statement'], install: false)
access_evaluator = executable('ntfs-dacl-evaluate', 'tools/access.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
logfile_inspector = executable('ntfs-logfile', 'tools/logfile.c', include_directories: inc, link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-benchmark', 'tools/benchmark.c', include_directories: inc, link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
threads = dependency('threads')
workload = executable('ntfs-workload', ['tools/workload.c', tool_path], include_directories: inc, link_with: [posix, core], dependencies: threads, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
python = find_program('python3')
test('sanitizer-runtime', python, args: [files('tests/sanitizer_runtime.py')], timeout: 120)
fixture = custom_target('fixtures', output: 'fixture.stamp', command: [python, files('tests/fixtures.py'), meson.current_build_dir() / 'fixtures', '@OUTPUT@'], depend_files: files('tests/link_count_fixtures.py', 'tests/secure_fixtures.py', 'tests/secure_store_fixtures.py', 'tests/security_validation_fixtures.py', 'tests/bad_clusters_fixtures.py', 'tests/case_fixtures.py', 'tests/stat_fixtures.py', 'tests/native_link_fixtures.py', 'tests/validation_fixtures.py', 'tests/boot_fixtures.py', 'tests/mirror_fixtures.py', 'tests/index_inventory_fixtures.py', 'tests/wof_file_fixtures.py', 'tests/wof_fixtures.py', 'tests/lzx_fixtures.py'), build_by_default: true)
unit = executable('ntfs-unit', 'tests/unit.c', include_directories: [inc, include_directories('core')], link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'])
link_count_fixture = custom_target('link-count-fixtures', output: 'link-count-fixtures.stamp', command: [python, files('tests/link_count_fixtures.py'), meson.current_build_dir() / 'link-count-fixtures', '@OUTPUT@'], depend_files: files('tests/fixtures.py', 'tests/validation_fixtures.py', 'tests/secure_fixtures.py', 'tests/secure_store_fixtures.py'), build_by_default: true)
links = executable('ntfs-link-count-tests', ['tests/links.c', 'tests/fuzz_device.c'], include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('link-counts', links, args: [meson.current_build_dir() / 'link-count-fixtures'], depends: link_count_fixture, timeout: 120)
test('link-counts-cli', python, args: [files('tests/links_cli.py'), inspector.full_path(), meson.current_build_dir() / 'link-count-fixtures'], depends: link_count_fixture, timeout: 120)
