metadata_objects_fixture = custom_target('metadata-objects-fixtures', output: 'metadata-objects-fixtures.stamp', command: [python, files('tests/metadata_objects_fixtures.py'), meson.current_build_dir() / 'metadata-objects-fixtures', '@OUTPUT@'], depend_files: files('tests/fixtures.py', 'tests/secure_fixtures.py', 'tests/secure_store_fixtures.py'), build_by_default: true)
