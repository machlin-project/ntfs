project('machlin-ntfs', 'c', version: '0.1.0', default_options: ['c_std=c11', 'warning_level=3', 'werror=true', 'buildtype=debugoptimized'])
cc = meson.get_compiler('c')
inc = include_directories('include', 'adapters/posix')
core_sources = files('core/support.c', 'core/operation.c', 'core/api.c', 'core/record.c', 'core/mst.c', 'core/logfile.c', 'core/logfile_source.c', 'core/logfile_pages.c', 'core/logfile_index.c', 'core/logfile_records.c', 'core/stream.c', 'core/stream_mapping.c', 'core/stream_read.c', 'core/unit_cache.c', 'core/lznt1.c', 'core/lzx.c', 'core/wof.c', 'core/wof_stream.c', 'core/xpress.c', 'core/attribute.c', 'core/catalog.c', 'core/node.c', 'core/links.c', 'core/unicode.c', 'core/mount.c', 'core/directory.c', 'core/index.c', 'core/reparse.c', 'core/security.c', 'core/secure_index.c', 'core/secure.c', 'core/secure_store.c', 'core/access.c', 'core/validate.c', 'core/validate_records.c', 'core/validate_media.c', 'core/validate_namespace.c', 'core/validate_security.c')
core_sources += files('core/logfile_tables.c', 'core/checkpoint.c', 'core/logfile_encode.c', 'core/recovery.c', 'core/overwrite.c')
core_sources += files('core/write_metadata.c', 'core/write_journal.c', 'core/write_replay.c', 'core/write_history.c', 'core/write_overlay.c', 'core/write_execute.c', 'core/write_transaction.c', 'core/write_recover.c')
core_sources += files('core/write_mutation.c', 'core/write_record.c', 'core/write_attribute.c', 'core/write_stream.c', 'core/write_mutation_bitmap.c', 'core/write_allocation.c', 'core/write_growth.c', 'core/write_directory.c', 'core/write_directory_store.c', 'core/write_directory_tree.c', 'core/write_inherit.c', 'core/write_namespace.c', 'core/write_hardlink.c')
core_sources += files('core/write_batch_pages.c', 'core/write_bitmap.c', 'core/write_retirement.c', 'core/write_program.c', 'core/write_program_packets.c')
core_sources += files('core/write_batch_execute.c')
core_sources += files('core/write_batch_capture.c', 'core/write_batch_tail.c', 'core/write_batch_restore.c', 'core/write_batch_recover.c')
core_sources += files('core/write_batch_restore_history.c')
core_sources += files('core/write_payload.c')
core_sources += files('core/write_checkpoint.c')
core_sources += files('core/write_checkpoint_recover.c')
core_sources += files('core/write_mutation_owner.c')
core_sources += files('core/memory.c')
core_sources += files('core/write_reparse.c')
core_sources += files('core/write_sparse.c')
core_sources += files('core/write_lznt1.c')
core_flags = ['-ffreestanding', '-fno-builtin', '-Wdeclaration-after-statement', '-Wframe-larger-than=2048']
core = static_library('ntfs', core_sources, include_directories: inc, c_args: core_flags, install: false)
cpu_memory = executable('ntfs-cpu-memory-tests', 'tests/cpu_memory.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_DARWIN_C_SOURCE', '-D_DEFAULT_SOURCE', '-Wdeclaration-after-statement'])
test('cpu-memory', cpu_memory, timeout: 120)
endian = executable('ntfs-endian-tests', 'tests/endian.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('endian', endian)
allocation_scan = executable('ntfs-allocation-scan-tests', ['tests/allocation_scan.c', 'tests/fuzz_device.c'], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('allocation-scan', allocation_scan, timeout: 120)
bitmap_pages = executable('ntfs-bitmap-pages-tests', ['tests/bitmap_pages.c', 'tests/fuzz_device.c'], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('bitmap-pages', bitmap_pages, timeout: 120)
directory_tree = executable('ntfs-directory-tree-tests', ['tests/directory_tree.c', 'tests/fuzz_device.c'], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('directory-tree', directory_tree, timeout: 120)
mutation_stream_cache = executable('ntfs-mutation-stream-cache-tests', ['tests/mutation_stream_cache.c', 'tests/fuzz_device.c'], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('mutation-stream-cache', mutation_stream_cache, timeout: 120)
mutation_lookup = executable('ntfs-mutation-lookup-tests', 'tests/mutation_lookup.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('mutation-lookup', mutation_lookup, timeout: 120)
executable('ntfs-core-benchmark', 'tools/benchmark_core.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-UNDEBUG', '-Wdeclaration-after-statement'])
mutation_benchmark = executable('ntfs-mutation-benchmark', 'tools/benchmark_mutation.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-UNDEBUG', '-Wdeclaration-after-statement'])
executable('ntfs-cpu-benchmark', 'tools/benchmark_cpu.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-UNDEBUG', '-Wdeclaration-after-statement'])
posix = static_library('ntfs-posix', 'adapters/posix/image.c', include_directories: inc, c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
tool_path = files('tools/path.c')
inspector = executable('ntfs-inspect', ['tools/inspect.c', tool_path], include_directories: inc, link_with: [posix, core], install: false)
validator = executable('ntfs-validate', 'tools/validate.c', include_directories: inc, link_with: [posix, core], c_args: ['-Wdeclaration-after-statement'], install: false)
executable('ntfs-native-inventory', 'tests/native_inventory.c', include_directories: inc, link_with: [posix, core], c_args: ['-UNDEBUG', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-native-state', 'tests/native_state.c', include_directories: [inc, include_directories('core')], link_with: [posix, core], c_args: ['-UNDEBUG', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-native-checkpoint', ['tests/native_checkpoint.c', 'tests/image_fault.c', 'adapters/posix/overwrite_image.c'], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-D_DARWIN_C_SOURCE', '-UNDEBUG', '-Wdeclaration-after-statement'], install: false)
access_evaluator = executable('ntfs-dacl-evaluate', 'tools/access.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
logfile_inspector = executable('ntfs-logfile', 'tools/logfile.c', include_directories: inc, link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-overwrite', ['tools/overwrite.c', 'adapters/posix/overwrite_image.c'], include_directories: inc, link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-D_DARWIN_C_SOURCE', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-benchmark', 'tools/benchmark.c', include_directories: inc, link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
threads = dependency('threads')
workload = executable('ntfs-workload', ['tools/workload.c', tool_path], include_directories: inc, link_with: [posix, core], dependencies: threads, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
python = find_program('python3')
test('directory-harness', python, args: [files('tests/directory_harness.py')], timeout: 60)
if host_machine.system() == 'darwin'
  executable('ntfs-mounted-directory', 'tests/mounted_directory.c', c_args: ['-D_DARWIN_C_SOURCE', '-UNDEBUG', '-Wdeclaration-after-statement'], install: false)
endif
cpu_fixture = custom_target('cpu-fixtures', output: 'cpu-fixtures.stamp', command: [python, files('tests/cpu_fixtures.py'), meson.current_build_dir() / 'cpu-fixtures', '@OUTPUT@'], depend_files: files('tests/lzx_fixtures.py', 'tests/wof_fixtures.py', 'tests/huffman_fixtures.py'), build_by_default: true)
cpu_codecs = executable('ntfs-cpu-codec-tests', 'tests/cpu_codecs.c', include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('cpu-codecs', cpu_codecs, args: [meson.current_build_dir() / 'cpu-fixtures'], depends: cpu_fixture, timeout: 120)
