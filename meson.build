project('machlin-ntfs', 'c', version: '0.1.0', default_options: ['c_std=c11', 'warning_level=3', 'werror=true', 'buildtype=debugoptimized'])
cc = meson.get_compiler('c')
inc = include_directories('include', 'adapters/posix')
core_sources = files('core/support.c', 'core/record.c', 'core/stream.c', 'core/lznt1.c', 'core/attribute.c', 'core/catalog.c', 'core/node.c', 'core/unicode.c', 'core/mount.c', 'core/directory.c', 'core/reparse.c', 'core/security.c', 'core/secure.c', 'core/access.c')
core_flags = ['-ffreestanding', '-fno-builtin', '-Wdeclaration-after-statement', '-Wframe-larger-than=2048']
core = static_library('ntfs', core_sources, include_directories: inc, c_args: core_flags, install: false)
posix = static_library('ntfs-posix', 'adapters/posix/image.c', include_directories: inc, c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
tool_path = files('tools/path.c')
inspector = executable('ntfs-inspect', ['tools/inspect.c', tool_path], include_directories: inc, link_with: [posix, core], install: false)
access_evaluator = executable('ntfs-dacl-evaluate', 'tools/access.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
executable('ntfs-benchmark', 'tools/benchmark.c', include_directories: inc, link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L'], install: false)
threads = dependency('threads')
workload = executable('ntfs-workload', ['tools/workload.c', tool_path], include_directories: inc, link_with: [posix, core], dependencies: threads, c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'], install: false)
python = find_program('python3')
fixture = custom_target('fixtures', output: 'fixture.stamp', command: [python, files('tests/fixtures.py'), meson.current_build_dir() / 'fixtures', '@OUTPUT@'], depend_files: files('tests/secure_fixtures.py', 'tests/case_fixtures.py'), build_by_default: true)
unit = executable('ntfs-unit', 'tests/unit.c', include_directories: [inc, include_directories('core')], link_with: [posix, core], c_args: ['-D_POSIX_C_SOURCE=200809L', '-Wdeclaration-after-statement'])
test('unit', unit, args: [meson.current_build_dir() / 'fixtures/standard.img'], depends: fixture, timeout: 120)
streams = executable('ntfs-stream-tests', 'tests/streams.c', include_directories: inc, link_with: [posix, core], c_args: ['-Wdeclaration-after-statement'])
test('streams', streams, args: [meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
codec = executable('ntfs-codec-tests', 'tests/codec.c', include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('codec', codec)
reparse = executable('ntfs-reparse-tests', 'tests/reparse.c', include_directories: inc, link_with: [posix, core], c_args: ['-Wdeclaration-after-statement'])
test('reparse', reparse, args: [meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
foreach layout : ['mft-resident-list', 'mft-nonresident-list', 'nested-index', 'ntfs30']
  test(layout, unit, args: [meson.current_build_dir() / 'fixtures' / (layout + '.img')], depends: fixture, timeout: 120)
endforeach
test('images', python, args: [files('tests/check_images.py'), inspector.full_path(), meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
fuzz_device = files('tests/fuzz_device.c')
fuzz = executable('ntfs-fuzz-smoke', ['tests/fuzz.c', fuzz_device], include_directories: inc, link_with: core, c_args: ['-DNTFS_FUZZ_STANDALONE', '-Wdeclaration-after-statement'])
test('fuzz-smoke', fuzz, args: [meson.current_build_dir() / 'fixtures/standard.img'], depends: fixture, timeout: 120)
fuzz_seeds = custom_target('fuzz-seeds', output: 'fuzz-seeds.stamp', command: [python, files('scripts/fuzz_seeds.py'), meson.current_build_dir() / 'fuzz-seeds', '@OUTPUT@'], depend_files: files('tests/fixtures.py'), build_by_default: true)
foreach target : ['mapping-pairs', 'attribute-list', 'index-root', 'index-block', 'lznt1', 'reparse', 'security']
  target_symbol = 'NTFS_FUZZ_' + target.replace('-', '_').to_upper()
  structure_fuzz = executable('ntfs-fuzz-' + target, ['tests/fuzz_structures.c', fuzz_device], include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-DNTFS_FUZZ_STANDALONE', '-DNTFS_FUZZ_TARGET=' + target_symbol, '-Wdeclaration-after-statement'])
  seed_name = {'mapping-pairs': 'negative-delta', 'attribute-list': 'base-data', 'index-root': 'entries', 'index-block': 'entries', 'lznt1': 'repeated', 'reparse': 'unpaired', 'security': 'object-callback'}[target]
  test('fuzz-' + target, structure_fuzz, args: [meson.current_build_dir() / 'fuzz-seeds' / target / (seed_name + '.seed')], depends: fuzz_seeds, timeout: 120)
endforeach
test('tool-environment', python, args: [files('tests/test_environment.py')])
access_fuzz = executable('ntfs-fuzz-access', 'tests/fuzz_access.c', include_directories: [inc, include_directories('core')], link_with: core, c_args: ['-DNTFS_FUZZ_STANDALONE', '-Wdeclaration-after-statement'])
test('fuzz-access', access_fuzz, args: [meson.current_build_dir() / 'fuzz-seeds/access/allow-group.seed'], depends: fuzz_seeds, timeout: 120)
test('corpus-contract', python, args: [files('tests/corpus_contract.py'), inspector.full_path()], timeout: 120)
test('workload-contract', python, args: [files('tests/workload_contract.py'), workload.full_path(), inspector.full_path()], timeout: 120)
metadata_cache = executable('ntfs-metadata-cache-tests', ['tests/metadata_cache.c', fuzz_device], include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('metadata-cache', metadata_cache, args: [meson.current_build_dir() / 'fixtures/metadata-presence-list.img'], depends: fixture, timeout: 120)
security = executable('ntfs-security-tests', 'tests/security.c', include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('security', security)
access = executable('ntfs-access-tests', 'tests/access.c', include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('access', access, timeout: 120)
test('access-oracle-contract', python, args: [files('tests/access_contract.py'), access_evaluator.full_path()], timeout: 120)
secure = executable('ntfs-secure-tests', ['tests/secure.c', fuzz_device], include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('secure', secure, args: [meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
catalog = executable('ntfs-catalog-tests', ['tests/catalog.c', fuzz_device], include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('catalog', catalog, args: [meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
case_policy = executable('ntfs-case-policy-tests', ['tests/case_policy.c', fuzz_device], include_directories: inc, link_with: core, c_args: ['-Wdeclaration-after-statement'])
test('case-policy', case_policy, args: [meson.current_build_dir() / 'fixtures'], depends: fixture, timeout: 120)
